{
  "name": "@aiqa/studio",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.18.0",
  "scripts": {
    "build": "node --experimental-strip-types build.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src build.ts eslint.config.ts verify-design-lint.ts --max-warnings 0",
    "format": "prettier --write src build.ts eslint.config.ts verify-design-lint.ts",
    "check": "yarn typecheck && yarn typecheck:server && yarn typecheck:worker && yarn typecheck:agent && yarn lint && yarn lint:server && yarn lint:verify && yarn test:dashboard && yarn test:table && yarn test:remote && yarn test:security && yarn build",
    "typecheck:server": "tsc -p ../server/tsconfig.json",
    "lint:server": "cd .. && node studio/node_modules/eslint/bin/eslint.js --config eslint.config.ts server/src/studio contracts browser-worker/src --max-warnings 0",
    "typecheck:worker": "tsc -p ../browser-worker/tsconfig.json",
    "lint:verify": "node --experimental-strip-types verify-design-lint.ts",
    "test:dashboard": "node --experimental-strip-types --test src/features/dashboard/metrics.test.ts src/features/workspace/tabs.test.ts src/features/workspace/store.test.ts",
    "test:security": "node --experimental-strip-types --test ../server/src/studio/infrastructure/phone-settings.test.ts ../server/src/studio/infrastructure/project-source.test.ts ../server/src/studio/infrastructure/auth.test.ts ../server/src/studio/infrastructure/device-inventory.test.ts ../server/src/studio/transport/remote-device.test.ts ../server/src/studio/infrastructure/webviews.test.ts ../server/src/studio/infrastructure/agent-registry.test.ts ../device-agent/mjpeg.test.ts ../device-agent/legacy-touch.test.ts ../device-agent/simulator-hid.test.ts ../device-agent/idb-video.test.ts",
    "test:table": "node --experimental-strip-types --test src/components/data-table-model.test.ts",
    "test:remote": "node --experimental-strip-types --test src/features/devices/touch-input.test.ts src/features/devices/remote-coordinates.test.ts src/features/devices/remote-control.test.ts src/features/devices/device-status.test.ts",
    "typecheck:agent": "tsc -p ../device-agent/tsconfig.json"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.49.0",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-is": "19.3.0",
    "recharts": "3.8.0",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@shadcn/lint": "0.2.0",
    "@tailwindcss/cli": "4.3.3",
    "@types/eslint-plugin-jsx-a11y": "6.10.1",
    "@types/node": "24.10.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/react-is": "^19",
    "@types/ws": "^8",
    "esbuild": "0.28.2",
    "eslint": "9.39.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "inspect-webkit": "0.0.5",
    "jiti": "2.7.0",
    "prettier": "3.9.9",
    "shadcn": "4.21.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "ws": "8.18.3"
  }
}
