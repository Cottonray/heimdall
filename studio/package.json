{
  "name": "@aiqa/studio",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.18.0",
  "scripts": {
    "build": "node --experimental-strip-types build.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src build.ts eslint.config.ts --max-warnings 0",
    "format": "prettier --write src build.ts eslint.config.ts",
    "check": "yarn typecheck && yarn typecheck:server && yarn typecheck:worker && yarn lint && yarn lint:server && yarn lint:verify && yarn build",
    "typecheck:server": "tsc -p ../server/tsconfig.json",
    "lint:server": "cd .. && node studio/node_modules/eslint/bin/eslint.js --config eslint.config.ts server/src/studio contracts browser-worker/src --max-warnings 0",
    "typecheck:worker": "tsc -p ../browser-worker/tsconfig.json",
    "lint:verify": "node --experimental-strip-types verify-design-lint.ts"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.49.0",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@shadcn/lint": "0.2.0",
    "@tailwindcss/cli": "4.3.3",
    "@types/eslint-plugin-jsx-a11y": "6.10.1",
    "@types/node": "24.10.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "jiti": "2.7.0",
    "prettier": "3.9.9",
    "shadcn": "4.21.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0"
  }
}
